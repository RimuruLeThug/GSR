// =============================================================================================
//  GSR — copy of the OPAQUE depth (before the translucent layer), standalone mode.
//  Later compared to the final depth: where the final one is closer, a translucent
//  surface (water, ice, glass) was drawn -> reflection mask without a material G-buffer.
// =============================================================================================
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D uDepth;
layout(r32f, binding = 0) writeonly uniform image2D uOpaqueOut;

uniform vec2 uScreenSize;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(uScreenSize)))) return;
    imageStore(uOpaqueOut, px, vec4(texelFetch(uDepth, px, 0).r));
}
