// =============================================================================================
//  GSR — Passe 1 : lancer de rayon hybride  SSR  ->  GSR (clipmap gaussienne)  ->  ciel
//  Sortie : uReflOut.rgb = radiance réfléchie (linéaire), .a = distance d'impact (−1 = pas de reflet)
// =============================================================================================
layout(local_size_x = 8, local_size_y = 8) in;

#include "gsr_common.glsl"
#include "gsr_screen.glsl"

layout(binding = 0) uniform sampler2D uDepth;
layout(binding = 1) uniform sampler2D uSceneColor;
layout(rgba16f, binding = 0) writeonly uniform image2D uReflOut;

uniform float uMaxTrace;

const int SSR_STEPS  = 48;
const int SSR_REFINE = 6;

/*
 * SSR : marche linéaire en espace écran avec interpolation de z correcte en perspective
 * (on interpole z/w et 1/w), puis raffinement binaire. Retourne une confiance ∈ [0,1] :
 * 0 = le rayon sort de l'écran / passe derrière une occlusion -> repli GSR.
 */
float ssrTrace(vec3 vp, vec3 rv, ivec2 px, out vec2 hitUV, out float hitDist) {
    hitUV = vec2(0.0); hitDist = 0.0;
    float len = 96.0;
    if (rv.z > 0.0) len = min(len, (-0.06 - vp.z) / rv.z);   // ne pas traverser le plan proche
    if (len <= 0.05) return 0.0;
    vec3 ve = vp + rv * len;
    vec4 h0 = uProj * vec4(vp, 1.0), h1 = uProj * vec4(ve, 1.0);
    float k0 = 1.0 / h0.w, k1 = 1.0 / h1.w;
    vec2 s0 = (h0.xy * k0 * 0.5 + 0.5) * uScreenSize;
    vec2 s1 = (h1.xy * k1 * 0.5 + 0.5) * uScreenSize;
    int steps = clamp(int(length(s1 - s0) / 3.0), 8, SSR_STEPS);
    float jitter = gsrIGN(vec2(px), uFrame);
    float prevF = 0.0;

    for (int i = 1; i <= steps; i++) {
        float f = (float(i) - 1.0 + jitter) / float(steps);
        vec2 s = mix(s0, s1, f);
        if (any(lessThan(s, vec2(0.0))) || any(greaterThanEqual(s, uScreenSize))) return 0.0;  // off-screen
        float rayZ   = mix(vp.z * k0, ve.z * k1, f) / mix(k0, k1, f);
        float sceneZ = gsrLinearViewZ(texelFetch(uDepth, ivec2(s), 0).r);
        float thickness = max(0.3, -rayZ * 0.03);
        if (rayZ < sceneZ) {
            if (sceneZ - rayZ > thickness) return 0.0;   // passé DERRIÈRE un objet : info absente de l'écran
            float lo = prevF, hi = f;
            for (int j = 0; j < SSR_REFINE; j++) {
                float m = 0.5 * (lo + hi);
                float rz = mix(vp.z * k0, ve.z * k1, m) / mix(k0, k1, m);
                float sz = gsrLinearViewZ(texelFetch(uDepth, ivec2(mix(s0, s1, m)), 0).r);
                if (rz < sz) hi = m; else lo = m;
            }
            hitUV = mix(s0, s1, hi) / uScreenSize;
            vec3 hp = mix(vp * k0, ve * k1, hi) / mix(k0, k1, hi);
            hitDist = length(hp - vp);
            vec2 e = abs(hitUV * 2.0 - 1.0);
            return 1.0 - smoothstep(0.85, 1.0, max(e.x, e.y));   // fondu vers GSR près des bords
        }
        prevF = f;
    }
    return 0.0;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(uScreenSize)))) return;

    float d = texelFetch(uDepth, px, 0).r;
    if (d >= 1.0) { imageStore(uReflOut, px, vec4(0.0, 0.0, 0.0, -1.0)); return; }

    vec2 uv = (vec2(px) + 0.5) / uScreenSize;
    vec3 vp = gsrViewPos(uv, d);
    vec3 nV = gsrViewNormalFromDepth(uDepth, px, vp);
    vec3 P  = (uInvView * vec4(vp, 1.0)).xyz;           // relatif caméra, non tourné
    vec3 N  = normalize(mat3(uInvView) * nV);

    float rough, mask;
    gsrStandaloneMaterial(N, px, d, rough, mask);
    if (mask <= 0.001) { imageStore(uReflOut, px, vec4(0.0, 0.0, 0.0, -1.0)); return; }

    // Direction : miroir parfait, ou microfacette GGX tirée (bruit -> lissé par la passe temporelle)
    vec3 Vw = normalize(P);
    float alpha = max(rough * rough, 1e-4);
    vec3 R;
    if (rough < 0.03) {
        R = reflect(Vw, N);
    } else {
        vec3 T, B; gsrBasis(N, T, B);
        vec3 Vt = vec3(dot(-Vw, T), dot(-Vw, B), dot(-Vw, N));
        vec2 u = fract(gsrR2(uFrame) + vec2(gsrIGN(vec2(px), uFrame), gsrIGN(vec2(px.yx), uFrame + 17)));
        vec3 Ht = gsrSampleGGXVNDF(Vt, alpha, u);
        R = reflect(Vw, normalize(T * Ht.x + B * Ht.y + N * Ht.z));
        if (dot(R, N) <= 0.0) R = reflect(Vw, N);
    }

    // ---- 1) SSR (précis, mais limité à ce que la caméra voit) ----
    vec3 rV = normalize(mat3(uView) * R);
    vec2 hitUV; float ssrDist;
    float conf = ssrTrace(vp + nV * 0.02, rV, px, hitUV, ssrDist);
    vec3 ssrCol = conf > 0.0 ? pow(textureLod(uSceneColor, hitUV, 0.0).rgb, vec3(2.2)) : vec3(0.0);

    vec3  col  = ssrCol;
    float dist = ssrDist;

    // ---- 2) Repli GSR : la scène à 360° autour du joueur, hors écran ou occultée ----
    if (conf < 0.999) {
        // Rugosité -> demi-angle du cône -> niveau de clipmap (reflet flou = splats plus gros = moins de pas)
        float coneTan = mix(0.002, 0.35, alpha);
        GsrHit gh = gsrTrace(P + N * 0.05, R, 0.02, uMaxTrace, coneTan, 0.0);
        vec3 g = gh.radiance + gh.transmittance * gsrSkyRadiance(R);
        col  = mix(g, ssrCol, conf);
        dist = mix(gh.hitDist, ssrDist, conf);
    }
    imageStore(uReflOut, px, vec4(col, dist));
}
