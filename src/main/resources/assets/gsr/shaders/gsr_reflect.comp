// =============================================================================================
//  GSR — Pass 1: hybrid ray tracing  SSR  ->  GSR (Gaussian clipmap)  ->  sky
//  Output: uReflOut.rgb = reflected radiance (linear), .a = hit distance (−1 = no reflection)
// =============================================================================================
layout(local_size_x = 8, local_size_y = 8) in;

#define GSR_COUNT_COST
#include "gsr_common.glsl"
#include "gsr_screen.glsl"

layout(binding = 0) uniform sampler2D uDepth;
layout(binding = 1) uniform sampler2D uSceneColor;
layout(rgba16f, binding = 0) writeonly uniform image2D uReflOut;
layout(r8ui,    binding = 1) writeonly uniform uimage2D uReprOut;   // representative pixel, re-read by the temporal pass

uniform float uMaxTrace;
uniform int   uDebugView;   // 0 normal, 1 SSR only (sky fallback), 2 GSR only, 3 raw GSR, 4 GSR hit, 5 raw reflection, 6 GSR cost

const int SSR_STEPS  = 48;
const int SSR_REFINE = 6;
const int SSR_BATCH  = 4;

/*
 * SSR: linear screen-space march with perspective-correct z interpolation
 * (we interpolate z/w and 1/w), then binary refinement. Returns a confidence ∈ [0,1]:
 * 0 = the ray leaves the screen / passes behind an occluder -> GSR fallback.
 */
float ssrTrace(vec3 vp, vec3 rv, ivec2 px, out vec2 hitUV, out float hitDist) {
    hitUV = vec2(0.0); hitDist = 0.0;
    float len = 96.0;
    if (rv.z > 0.0) len = min(len, (-0.06 - vp.z) / rv.z);   // do not cross the near plane
    if (len <= 0.05) return 0.0;
    vec3 ve = vp + rv * len;
    vec4 h0 = uProj * vec4(vp, 1.0), h1 = uProj * vec4(ve, 1.0);
    float k0 = 1.0 / h0.w, k1 = 1.0 / h1.w;
    vec2 s0 = (h0.xy * k0 * 0.5 + 0.5) * uScreenSize;
    vec2 s1 = (h1.xy * k1 * 0.5 + 0.5) * uScreenSize;
    int steps = clamp(int(length(s1 - s0) / 3.0), 8, SSR_STEPS);
    float jitter = gsrIGN(vec2(px), uFrame);
    float prevF = 0.0;
    ivec2 maxPx = ivec2(uScreenSize) - 1;

    // The march is bound by the latency of dependent depth reads: the depths of SSR_BATCH
    // consecutive steps are fetched together, then tested in order (same samples, same result
    // as one read per step; SSR 0.222 -> 0.200 ms, see docs/ARCHITECTURE.md §6).
    for (int i0 = 1; i0 <= steps; i0 += SSR_BATCH) {
        float depths[SSR_BATCH];
        for (int b = 0; b < SSR_BATCH; b++) {
            vec2 s = mix(s0, s1, (float(i0 + b) - 1.0 + jitter) / float(steps));
            depths[b] = texelFetch(uDepth, clamp(ivec2(s), ivec2(0), maxPx), 0).r;
        }
        for (int b = 0; b < SSR_BATCH; b++) {
            int i = i0 + b;
            if (i > steps) return 0.0;
            float f = (float(i) - 1.0 + jitter) / float(steps);
            vec2 s = mix(s0, s1, f);
            if (any(lessThan(s, vec2(0.0))) || any(greaterThanEqual(s, uScreenSize))) return 0.0;  // off-screen
            float rayZ   = mix(vp.z * k0, ve.z * k1, f) / mix(k0, k1, f);
            float sceneZ = gsrLinearViewZ(depths[b]);
            if (rayZ < sceneZ) {
                // Refinement BEFORE the thickness test: a coarse step (up to ~20 px) on a slope seen at a
                // grazing angle far exceeds the thickness, which made SSR miss clearly visible objects
                // (reflected hill -> blurry GSR fallback). Only the gap at the refined point tells whether the
                // ray really passes behind a silhouette.
                float lo = prevF, hi = f;
                for (int j = 0; j < SSR_REFINE; j++) {
                    float m = 0.5 * (lo + hi);
                    float rz = mix(vp.z * k0, ve.z * k1, m) / mix(k0, k1, m);
                    float sz = gsrLinearViewZ(texelFetch(uDepth, ivec2(mix(s0, s1, m)), 0).r);
                    if (rz < sz) hi = m; else lo = m;
                }
                float hz = mix(vp.z * k0, ve.z * k1, hi) / mix(k0, k1, hi);
                float sz = gsrLinearViewZ(texelFetch(uDepth, ivec2(mix(s0, s1, hi)), 0).r);
                if (sz - hz > max(0.3, -hz * 0.03)) return 0.0;   // passed BEHIND an object: information absent from the screen
                hitUV = mix(s0, s1, hi) / uScreenSize;
                vec3 hp = mix(vp * k0, ve * k1, hi) / mix(k0, k1, hi);
                hitDist = length(hp - vp);
                vec2 e = abs(hitUV * 2.0 - 1.0);
                // Fade to GSR only over the ~2 % closest to the edge: GSR (one color per face)
                // is blurry next to SSR, a 7.5 % band (0.85) showed up as a blurry reflection at the edge.
                return 1.0 - smoothstep(0.96, 1.0, max(e.x, e.y));
            }
            prevF = f;
        }
    }
    return 0.0;
}

void main() {
    ivec2 lp = ivec2(gl_GlobalInvocationID.xy);   // target texel (low resolution)
    if (any(greaterThanEqual(lp, gsrLowResSize()))) return;

    float d, rough, mask; vec3 vp, nV, N;
    ivec2 px = gsrRepresentative(uDepth, lp, d, vp, nV, N, rough, mask);
    if (mask <= 0.001) { imageStore(uReflOut, lp, vec4(0.0, 0.0, 0.0, -1.0)); return; }
    ivec2 rel = px - lp * uResScale;
    imageStore(uReprOut, lp, uvec4(uint(rel.x + rel.y * uResScale)));
    vec3 P  = (uInvView * vec4(vp, 1.0)).xyz;           // camera-relative, unrotated

    // Direction: perfect mirror, or sampled GGX microfacet (noise -> smoothed by the temporal pass)
    vec3 Vw = normalize(P);
    float alpha = max(rough * rough, 1e-4);
    vec3 R;
    if (rough < 0.03) {
        R = reflect(Vw, N);
    } else {
        vec3 T, B; gsrBasis(N, T, B);
        vec3 Vt = vec3(dot(-Vw, T), dot(-Vw, B), dot(-Vw, N));
        vec2 u = fract(gsrR2(uFrame) + vec2(gsrIGN(vec2(px), uFrame), gsrIGN(vec2(px.yx), uFrame + 17)));
        vec3 Ht = gsrSampleGGXVNDF(Vt, alpha, u);
        R = reflect(Vw, normalize(T * Ht.x + B * Ht.y + N * Ht.z));
        if (dot(R, N) <= 0.0) R = reflect(Vw, N);
    }

    // ---- 1) SSR (accurate, but limited to what the camera sees) ----
    vec3 rV = normalize(mat3(uView) * R);
    vec2 hitUV; float ssrDist;
    float conf = uDebugView >= 2 && uDebugView <= 4 ? 0.0 : ssrTrace(vp + nV * 0.02, rV, px, hitUV, ssrDist);
    vec3 ssrCol = conf > 0.0 ? pow(textureLod(uSceneColor, hitUV, 0.0).rgb, vec3(2.2)) : vec3(0.0);

    vec3  col  = ssrCol;
    float dist = ssrDist;

    // ---- 2) GSR fallback: the 360° scene around the player, off-screen or occluded ----
    if (conf < 0.999 && uDebugView == 1) {
        col  = mix(gsrSkyRadiance(R), ssrCol, conf);
        dist = mix(uMaxTrace, ssrDist, conf);
    } else if (conf < 0.999) {
        // Roughness -> cone half-angle -> clipmap level (blurry reflection = bigger splats = fewer steps)
        float coneTan = mix(0.002, 0.35, alpha);
        GsrHit gh = gsrTrace(P + N * 0.05, R, 0.02, uMaxTrace, coneTan, 0.0);
        vec3 g = gh.radiance + gh.transmittance * gsrSkyRadiance(R);
        col  = mix(g, ssrCol, conf);
        dist = mix(gh.hitDist, ssrDist, conf);
        // "Hit" view: r = transmittance, g = distance / 16, b = (level + 1) / 4 (0 = nothing hit)
        if (uDebugView == 4) col = vec3(gh.transmittance, gh.hitDist / 16.0, float(gh.level + 1) / 4.0);
        // "Cost" view: r = GSR steps / 64, g = splats read / 128, b = splats rejected as back-facing / 128
        if (uDebugView == 6) col = vec3(float(gsrCostSteps) / 64.0, float(gsrCostSplats) / 128.0, float(gsrCostBack) / 128.0);
    }
    if (uDebugView == 6 && conf >= 0.999) col = vec3(0.0);   // cost view: GSR not traced
    imageStore(uReflOut, lp, vec4(col, dist));
}
