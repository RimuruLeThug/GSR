// =============================================================================================
//  GSR — Pass 3: composition into the scene color (Fresnel + environment BRDF)
// =============================================================================================
layout(local_size_x = 8, local_size_y = 8) in;

#include "gsr_screen.glsl"

layout(binding = 0) uniform sampler2D uDepth;
layout(binding = 2) uniform sampler2D uReflection;     // accumulated history (linear, low resolution)
layout(binding = 4) uniform sampler2D uReflDist;       // camera distance of the representative pixel (1e9 = empty)
layout(rgba8, binding = 0) uniform image2D uScene;     // main framebuffer (read/write)
uniform int uDebugView;                                // 3: raw GSR (no Fresnel), 4: raw hit codes, 5: raw hybrid reflection, 6: raw cost codes

/*
 * Depth-guided upsampling: the 4 low-resolution texels around the pixel, weighted
 * bilinearly × camera-distance similarity (a silhouette does not bleed onto the background).
 * The small bilinear floor makes an isolated pixel fall back to the texel with the closest
 * distance. At full resolution (uResScale = 1), it is exactly a read of the pixel's texel.
 */
vec4 upsampleReflection(ivec2 px, float dist) {
    ivec2 lowMax = gsrLowResSize() - 1;
    vec2 f = (vec2(px) + 0.5) / float(uResScale) - 0.5;
    ivec2 b = ivec2(floor(f));
    vec2 t = f - vec2(b);
    float tol = 0.02 * dist + 0.05;
    vec4 acc = vec4(0.0);
    float wsum = 0.0;
    for (int j = 0; j < 2; j++)
        for (int i = 0; i < 2; i++) {
            ivec2 q = clamp(b + ivec2(i, j), ivec2(0), lowMax);
            vec4 h = texelFetch(uReflection, q, 0);
            if (h.a <= 0.0) continue;
            float bil = (i == 0 ? 1.0 - t.x : t.x) * (j == 0 ? 1.0 - t.y : t.y);
            float w = (bil + 1e-3) * exp(-abs(texelFetch(uReflDist, q, 0).r - dist) / tol);
            acc += h * w; wsum += w;
        }
    return wsum > 1e-30 ? acc / wsum : vec4(0.0);
}

// Analytic approximation of the environment BRDF (Karis, "Mobile PBR")
vec2 envBRDFApprox(float NoV, float rough) {
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
    const vec4 c1 = vec4( 1.0,  0.0425,  1.04, -0.04);
    vec4 r = rough * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * NoV)) * r.x + r.y;
    return vec2(-1.04, 1.04) * a004 + r.zw;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(uScreenSize)))) return;
    float d = texelFetch(uDepth, px, 0).r;
    if (d >= 1.0) return;
    if (uFloorStrength <= 0.0 && gsrTranslucentMask(px, d) == 0.0) return;   // cheap test

    vec2 uv = (vec2(px) + 0.5) / uScreenSize;
    vec3 vp = gsrViewPos(uv, d);
    vec3 nV = gsrViewNormalFromDepth(uDepth, px, vp);
    vec3 N  = normalize(mat3(uInvView) * nV);
    float rough, mask;
    gsrStandaloneMaterial(N, px, d, rough, mask);
    if (mask <= 0.001) return;

    vec4 refl = upsampleReflection(px, length(vp));
    if (refl.a <= 0.0) return;                         // no history = no reflection

    float NoV = clamp(dot(nV, -normalize(vp)), 1e-3, 1.0);
    const float F0 = 0.02;                             // water / dielectrics
    vec2 AB = envBRDFApprox(NoV, rough);
    float spec = clamp((F0 * AB.x + AB.y) * mask, 0.0, 1.0);

    // Soft highlight compression (the framebuffer is 8-bit, with no tone mapping):
    // linear up to a luminance K, logarithmic beyond -> no more saturated white disc.
    // K = 8: water seen from above reflects only ~3 % (Fresnel), ~10-20 is needed for a clear reflection.
    const float K = 8.0;
    float lum = dot(refl.rgb, vec3(0.2126, 0.7152, 0.0722));
    vec3 reflC = lum > K ? refl.rgb * (K * (1.0 + log(lum / K)) / lum) : refl.rgb;

    vec4 scene = imageLoad(uScene, px);
    vec3 sceneLin = pow(scene.rgb, vec3(2.2));
    vec3 outLin = sceneLin * (1.0 - spec) + reflC * spec;
    if (uDebugView == 3 || uDebugView == 5) outLin = reflC;
    if (uDebugView == 4 || uDebugView == 6) { imageStore(uScene, px, vec4(refl.rgb, scene.a)); return; }
    imageStore(uScene, px, vec4(pow(outLin, vec3(1.0 / 2.2)), scene.a));
}
