// =============================================================================================
//  GSR — Passe 3 : composition dans la couleur de scène (Fresnel + BRDF d'environnement)
// =============================================================================================
layout(local_size_x = 8, local_size_y = 8) in;

#include "gsr_screen.glsl"

layout(binding = 0) uniform sampler2D uDepth;
layout(binding = 2) uniform sampler2D uReflection;     // historique accumulé (linéaire, basse résolution)
layout(binding = 4) uniform sampler2D uReflDist;       // distance caméra du pixel représentatif (1e9 = vide)
layout(rgba8, binding = 0) uniform image2D uScene;     // framebuffer principal (lecture/écriture)

/*
 * Upsampling guidé par la profondeur : les 4 texels basse résolution autour du pixel, pondérés
 * bilinéairement × similarité de distance caméra (une silhouette ne bave pas sur l'arrière-plan).
 * Le petit plancher bilinéaire fait qu'un pixel isolé prend, à défaut, le texel de distance la plus
 * proche. En pleine résolution (uResScale = 1), revient exactement à lire le texel du pixel.
 */
vec4 upsampleReflection(ivec2 px, float dist) {
    ivec2 lowMax = gsrLowResSize() - 1;
    vec2 f = (vec2(px) + 0.5) / float(uResScale) - 0.5;
    ivec2 b = ivec2(floor(f));
    vec2 t = f - vec2(b);
    float tol = 0.02 * dist + 0.05;
    vec4 acc = vec4(0.0);
    float wsum = 0.0;
    for (int j = 0; j < 2; j++)
        for (int i = 0; i < 2; i++) {
            ivec2 q = clamp(b + ivec2(i, j), ivec2(0), lowMax);
            vec4 h = texelFetch(uReflection, q, 0);
            if (h.a <= 0.0) continue;
            float bil = (i == 0 ? 1.0 - t.x : t.x) * (j == 0 ? 1.0 - t.y : t.y);
            float w = (bil + 1e-3) * exp(-abs(texelFetch(uReflDist, q, 0).r - dist) / tol);
            acc += h * w; wsum += w;
        }
    return wsum > 1e-30 ? acc / wsum : vec4(0.0);
}

// Approximation analytique de la BRDF d'environnement (Karis, "Mobile PBR")
vec2 envBRDFApprox(float NoV, float rough) {
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
    const vec4 c1 = vec4( 1.0,  0.0425,  1.04, -0.04);
    vec4 r = rough * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * NoV)) * r.x + r.y;
    return vec2(-1.04, 1.04) * a004 + r.zw;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(uScreenSize)))) return;
    float d = texelFetch(uDepth, px, 0).r;
    if (d >= 1.0) return;
    if (uFloorStrength <= 0.0 && gsrTranslucentMask(px, d) == 0.0) return;   // test bon marché

    vec2 uv = (vec2(px) + 0.5) / uScreenSize;
    vec3 vp = gsrViewPos(uv, d);
    vec3 nV = gsrViewNormalFromDepth(uDepth, px, vp);
    vec3 N  = normalize(mat3(uInvView) * nV);
    float rough, mask;
    gsrStandaloneMaterial(N, px, d, rough, mask);
    if (mask <= 0.001) return;

    vec4 refl = upsampleReflection(px, length(vp));
    if (refl.a <= 0.0) return;                         // pas d'historique = pas de reflet

    float NoV = clamp(dot(nV, -normalize(vp)), 1e-3, 1.0);
    const float F0 = 0.02;                             // eau / diélectriques
    vec2 AB = envBRDFApprox(NoV, rough);
    float spec = clamp((F0 * AB.x + AB.y) * mask, 0.0, 1.0);

    // Compression douce des hautes lumières (le framebuffer est en 8 bits, sans tone mapping) :
    // linéaire jusqu'à une luminance K, logarithmique au-delà -> plus de disque blanc saturé.
    // K = 8 : l'eau vue de haut ne réfléchit que ~3 % (Fresnel), il faut ~10-20 pour un reflet franc.
    const float K = 8.0;
    float lum = dot(refl.rgb, vec3(0.2126, 0.7152, 0.0722));
    vec3 reflC = lum > K ? refl.rgb * (K * (1.0 + log(lum / K)) / lum) : refl.rgb;

    vec4 scene = imageLoad(uScene, px);
    vec3 sceneLin = pow(scene.rgb, vec3(2.2));
    vec3 outLin = sceneLin * (1.0 - spec) + reflC * spec;
    imageStore(uScene, px, vec4(pow(outLin, vec3(1.0 / 2.2)), scene.a));
}
