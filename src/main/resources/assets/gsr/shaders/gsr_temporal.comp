// =============================================================================================
//  GSR — Pass 2: temporal accumulation (reprojection + neighborhood clipping)
//
//  Two reprojections, blended according to roughness:
//   - rough surfaces  : reprojection of the SURFACE (the blurry reflection "sticks" to the ground);
//   - smooth surfaces : reprojection of the VIRTUAL IMAGE (P + V·hit distance): a mirror's
//     reflection moves with the parallax of the reflected object, not with the mirror.
//  Long history + wide clipping on rough (kills GGX noise), short + tight on smooth
//  (no trails): sharpness on calm water, natural dispersion on matte blocks.
// =============================================================================================
layout(local_size_x = 8, local_size_y = 8) in;

#include "gsr_screen.glsl"

layout(binding = 0) uniform sampler2D uDepth;
layout(binding = 1) uniform usampler2D uRepr;     // index of the representative pixel (reflection pass)
layout(binding = 2) uniform sampler2D uCurrent;   // rgb + hit distance
layout(binding = 3) uniform sampler2D uHistory;   // rgb + history length
layout(binding = 4) uniform sampler2D uPrevDist;  // camera distance of the previous frame
layout(rgba16f, binding = 0) writeonly uniform image2D uHistoryOut;
layout(r32f,    binding = 1) writeonly uniform image2D uDistOut;

uniform mat4 uPrevViewProj;   // proj_{n-1} · view_{n-1}, camera n-1 relative space
uniform vec3 uCamDelta;       // camPos_n − camPos_{n-1}
uniform int  uHistoryValid;

vec3 toYCoCg(vec3 c) { return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b); }
vec3 fromYCoCg(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

vec3 clipToAABB(vec3 center, vec3 extent, vec3 q) {
    vec3 v = q - center;
    vec3 a = abs(v / max(extent, vec3(1e-4)));
    float m = max(a.x, max(a.y, a.z));
    return m > 1.0 ? center + v / m : q;
}

void main() {
    ivec2 lp = ivec2(gl_GlobalInvocationID.xy);   // low-resolution texel
    ivec2 lowSize = gsrLowResSize();
    if (any(greaterThanEqual(lp, lowSize))) return;

    vec4 cur = texelFetch(uCurrent, lp, 0);
    if (cur.a < 0.0) {   // the reflection pass found no reflecting pixel in this block
        imageStore(uHistoryOut, lp, vec4(0.0));
        imageStore(uDistOut, lp, vec4(1e9));
        return;
    }
    // Representative pixel chosen by the reflection pass (instead of redoing the search: up to 4
    // normal reconstructions per texel). Standalone mode: uniform roughness.
    uint ri = texelFetch(uRepr, lp, 0).r;
    ivec2 px = lp * uResScale + ivec2(int(ri) % uResScale, int(ri) / uResScale);
    vec3 vp = gsrViewPos((vec2(px) + 0.5) / uScreenSize, texelFetch(uDepth, px, 0).r);
    float rough = uRoughness;
    vec3 P = (uInvView * vec4(vp, 1.0)).xyz;
    // The reflection comes from the representative pixel, but the history is stored at the texel center:
    // we read the history offset by the same amount, otherwise every frame would resample it by ¼ texel
    // (cumulative blur with a still camera).
    vec2 corr = (vec2(lp * uResScale) + 0.5 * float(uResScale) - (vec2(px) + 0.5)) / uScreenSize;

    // ---- hybrid surface / virtual-image reprojection ----
    vec3 Pprev = P + uCamDelta;
    vec2 uvSurf = gsrProject(uPrevViewProj, Pprev);
    vec3 Pvirt  = P + normalize(P) * cur.a;
    vec2 uvVirt = gsrProject(uPrevViewProj, Pvirt + uCamDelta);
    float smoothF = 1.0 - smoothstep(0.1, 0.45, rough);
    vec2 uvPrev = mix(uvSurf, uvVirt, smoothF);

    bool valid = uHistoryValid != 0
              && all(greaterThanEqual(uvPrev, vec2(0.0))) && all(lessThanEqual(uvPrev, vec2(1.0)))
              && all(greaterThanEqual(uvSurf, vec2(0.0))) && all(lessThanEqual(uvSurf, vec2(1.0)));
    if (valid) {   // disocclusion: was the surface visible at the same place?
        float prevDist = textureLod(uPrevDist, gsrScreenToLowUV(uvSurf + corr), 0.0).r;
        float expected = length(Pprev);
        valid = abs(prevDist - expected) < 0.05 * expected + 0.1;
    }

    // ---- 3x3 neighborhood statistics (YCoCg) ----
    vec3 m1 = vec3(0.0), m2 = vec3(0.0);
    float n = 0.0;
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++) {
            vec4 s = texelFetch(uCurrent, clamp(lp + ivec2(x, y), ivec2(0), lowSize - 1), 0);
            if (s.a < 0.0) continue;
            vec3 c = toYCoCg(s.rgb);
            m1 += c; m2 += c * c; n += 1.0;
        }
    m1 /= n; m2 /= n;
    vec3 sigma = sqrt(max(m2 - m1 * m1, vec3(0.0)));
    float gamma = mix(1.0, 2.5, rough);

    vec4 hist = textureLod(uHistory, gsrScreenToLowUV(uvPrev + corr), 0.0);
    vec3 histC = fromYCoCg(clipToAABB(m1, gamma * sigma, toYCoCg(hist.rgb)));

    float maxLen = mix(12.0, 48.0, rough);
    float len = valid ? min(hist.a + 1.0, maxLen) : 1.0;
    vec3 outC = mix(histC, cur.rgb, 1.0 / len);

    imageStore(uHistoryOut, lp, vec4(outC, len));
    imageStore(uDistOut, lp, vec4(length(P)));
}
